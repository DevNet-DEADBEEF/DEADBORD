{
  "name": "deadbord-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file=.env -e \"require('child_process').execFileSync('mongosh',['--nodb','--quiet','db/setup.mongosh.js'],{stdio:'inherit'})\"",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsc && node --env-file=.env dist/index.js",
    "db:seed": "tsc && node --env-file=.env dist/scripts/seed.js",
    "build:web": "cd ../frontend && npx expo export --platform web",
    "tdlp:keygen": "tsc && node --env-file-if-exists=.env dist/scripts/tdlp-keygen.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@deadbord/lmp": "file:../TDLP/lmp",
    "@deadbord/tdlp": "file:../TDLP/tdlp",
    "@deadbord/tlon": "file:../TDLP/tlon",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.7"
  }
}
