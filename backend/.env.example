MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_HOST=10.20.0.10:27017
# MONGO_DB=DEADBORD

# HTTP server
PORT=3000
# Public base URL; OAuth callbacks are <PUBLIC_URL>/auth/oauth/<provider>/callback
PUBLIC_URL=http://localhost:3000
# STATIC_DIR=../frontend/dist
# 64 hex chars, shared by every backend instance: openssl rand -hex 32
AUTH_SECRET=
# Where finished logins may redirect (comma separated).
# Default: <PUBLIC_URL>/auth/callback,http://localhost:8081/auth/callback,deadbord://auth
# Add the Expo Go URL for mobile dev, e.g. exp://192.168.1.5:8081/--/auth
# ALLOWED_REDIRECTS=
# Origins allowed to call the API from another origin (default: the Expo web dev server and the desktop app)
# CORS_ORIGINS=http://localhost:8081,app://deadbord
# TDLP (UDP) server for boards, lists and tasks
# TDLP_PORT=3001
# TDLP_HOST=0.0.0.0
# RSA private key; `npm run tdlp:keygen` writes this and frontend/electron/tdlp-public.pem
# TDLP_PRIVATE_KEY_FILE=tdlp-private.pem
# Unique per instance, 0-1023 (snowflake IDs)
WORKER_ID=0

# Outgoing mail for email logins. Without MAILTRAP_TOKEN or SMTP_HOST, login codes are written to the server log.
# Mailtrap (Sending > Sending Domains > your domain > Integration > SMTP): the API token, and a From
# address on that verified domain. Uses live.smtp.mailtrap.io:587 as user "api".
# MAILTRAP_TOKEN=
# SMTP_FROM=DEADBORD <no-reply@your-verified-domain.com>
# Any other SMTP server (this wins over MAILTRAP_TOKEN). For Mailtrap's Email Sandbox, which catches
# mail in a test inbox instead of delivering it: SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=2525,
# and the inbox's SMTP username and password.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# OAuth2 providers; a provider is offered only when both values are set.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_ROBLOX_CLIENT_ID=
OAUTH_ROBLOX_CLIENT_SECRET=
