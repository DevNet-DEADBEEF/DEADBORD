MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_HOST=10.20.0.10:27017
# MONGO_DB=DEADBORD

# HTTP server
PORT=3000
# Public base URL; OAuth callbacks are <PUBLIC_URL>/auth/oauth/<provider>/callback
PUBLIC_URL=http://localhost:3000
# STATIC_DIR=../frontend/dist
# 64 hex chars, shared by every backend instance: openssl rand -hex 32
AUTH_SECRET=
# Where finished logins may redirect (comma separated).
# Default: <PUBLIC_URL>/auth/callback,http://localhost:8081/auth/callback,deadbord://auth
# Add the Expo Go URL for mobile dev, e.g. exp://192.168.1.5:8081/--/auth
# ALLOWED_REDIRECTS=
# Origins allowed to call the API from another origin (default: the Expo web dev server)
# CORS_ORIGINS=http://localhost:8081
# Unique per instance, 0-1023 (snowflake IDs)
WORKER_ID=0

# OAuth2 providers; a provider is offered only when both values are set.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_ROBLOX_CLIENT_ID=
OAUTH_ROBLOX_CLIENT_SECRET=
